      {
       "type": "heading",
       "heading": "Salt tank",
       "icon": "mdi:shaker-outline"
      },
      {
       "type": "gauge",
       "entity": "sensor.salt_softener_level",
       "needle": true,
       "min": 0,
       "max": 100,
       "severity": {
        "green": 50,
        "yellow": 25,
        "red": 0
       },
       "name": "Water Softener Salt",
       "unit": "%"
      },
      {
       "type": "entities",
